generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  slug           String    @unique
  logoPath       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([isActive, name])
}

model Product {
  id                String           @id @default(cuid())
  sku               String           @unique
  article           String
  normalizedArticle String
  name              String
  slug              String           @unique
  description       String?
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  categoryId        String?
  category          Category?        @relation(fields: [categoryId], references: [id])
  unit              String?
  imagePath         String?
  qualityLevel      String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  offers            SupplierOffer[]
  importRows        PriceImportRow[]
  supplierItems     SupplierCatalogItem[]
  supplierMappings  SupplierProductMapping[]
  matchCandidates   ProductMatchCandidate[]
  enrichmentDecisions EnrichmentDecision[]
  images            ProductImage[]

  @@unique([brandId, normalizedArticle])
  @@index([normalizedArticle])
  @@index([article])
  @@index([name])
  @@index([categoryId])
  @@index([qualityLevel])
  @@index([isActive, createdAt])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  warehouses Warehouse[]
  offers    SupplierOffer[]
  imports   PriceImport[]
  mappings  SupplierProductMapping[]
  catalogItems SupplierCatalogItem[]
  enrichmentJobs EnrichmentJob[]
}

model Warehouse {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  name       String
  code       String
  city       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  offers     SupplierOffer[]
  catalogItems SupplierCatalogItem[]

  @@unique([supplierId, code])
  @@index([supplierId])
}

model SupplierOffer {
  id                   String           @id @default(cuid())
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  supplierId           String
  supplier             Supplier         @relation(fields: [supplierId], references: [id])
  warehouseId          String?
  warehouse            Warehouse?       @relation(fields: [warehouseId], references: [id])
  supplierArticle      String
  purchasePrice        Decimal          @db.Decimal(14, 2)
  retailPrice          Decimal          @db.Decimal(14, 2)
  currency             String           @default("RUB")
  stockQuantity        Int
  minimumOrderQuantity Int              @default(1)
  deliveryDaysMin      Int?
  deliveryDaysMax      Int?
  availableAt          DateTime?
  sourceUpdatedAt      DateTime?
  supplierCatalogItemId String?
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id])
  matchedAt            DateTime?
  matchingMethod       MatchingMethod?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  importRows           PriceImportRow[]

  @@unique([supplierId, warehouseId, supplierArticle])
  @@unique([productId, supplierId, warehouseId, supplierCatalogItemId])
  @@index([productId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([retailPrice])
  @@index([stockQuantity])
  @@index([isActive])
  @@index([supplierCatalogItemId])
}

model PriceImport {
  id              String           @id @default(cuid())
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  sourceFilename  String
  sourceHash      String
  status          String
  totalRows       Int              @default(0)
  validRows       Int              @default(0)
  invalidRows     Int              @default(0)
  createdProducts Int              @default(0)
  updatedProducts Int              @default(0)
  createdOffers   Int              @default(0)
  updatedOffers   Int              @default(0)
  startedAt       DateTime
  finishedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  rows            PriceImportRow[]
  catalogItems    SupplierCatalogItem[]
  reviewIssues    ImportReviewIssue[]

  @@index([supplierId])
  @@index([sourceHash, status])
}

model PriceImportRow {
  id             String        @id @default(cuid())
  importId       String
  import         PriceImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  status         String
  errorCode      String?
  errorMessage   String?
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  offerId        String?
  offer          SupplierOffer? @relation(fields: [offerId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([importId, rowNumber])
  @@index([status])
  @@index([productId])
  @@index([offerId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}
enum MatchingStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
  NEEDS_REVIEW
  REJECTED
}

enum MatchingMethod {
  EXACT_BRAND_ARTICLE
  EXACT_SOURCE_MAPPING
  ARTICLE_NAME
  MANUAL
  NONE
}

enum CandidateStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum Severity {
  INFO
  WARNING
  ERROR
}

model SupplierCatalogItem {
  id                      String                  @id @default(cuid())
  supplierId              String
  supplier                Supplier                @relation(fields: [supplierId], references: [id])
  warehouseId             String?
  warehouse               Warehouse?              @relation(fields: [warehouseId], references: [id])
  sourceKey               String
  sourceArticle           String?
  normalizedSourceArticle String?
  sourceName              String?
  normalizedSourceName    String?
  sourceBrand             String?
  sourceCategory          String?
  sourceUnit              String?
  sourceStockRaw          String?
  sourcePriceRaw          String?
  purchasePrice           Decimal?                @db.Decimal(14, 2)
  retailPrice             Decimal?                @db.Decimal(14, 2)
  currency                String                  @default("RUB")
  stockQuantity           Int?
  deliveryDaysMin         Int?
  deliveryDaysMax         Int?
  minimumOrderQuantity    Int                     @default(1)
  rawData                 Json
  sourceRowNumber         Int
  sourceUpdatedAt         DateTime?
  lastImportId            String?
  lastImport              PriceImport?            @relation(fields: [lastImportId], references: [id])
  matchingStatus          MatchingStatus          @default(UNMATCHED)
  matchedProductId        String?
  matchedProduct          Product?                @relation(fields: [matchedProductId], references: [id])
  matchingConfidence      Decimal?                @db.Decimal(5, 2)
  matchingMethod          MatchingMethod          @default(NONE)
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  offers                  SupplierOffer[]
  candidates              ProductMatchCandidate[]
  reviewIssues            ImportReviewIssue[]
  enrichmentCandidates    EnrichmentCandidate[]

  @@unique([supplierId, warehouseId, sourceKey])
  @@index([supplierId, matchingStatus])
  @@index([warehouseId])
  @@index([normalizedSourceArticle])
  @@index([matchedProductId])
  @@index([lastImportId])
  @@index([isActive])
}

model SupplierProductMapping {
  id                      String   @id @default(cuid())
  supplierId              String
  supplier                Supplier @relation(fields: [supplierId], references: [id])
  sourceArticle           String
  normalizedSourceArticle String
  sourceName              String?
  productId               String
  product                 Product  @relation(fields: [productId], references: [id])
  confidence              Decimal  @db.Decimal(5, 2)
  createdBy               String?
  note                    String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([supplierId, normalizedSourceArticle, productId])
  @@index([supplierId, normalizedSourceArticle, isActive])
  @@index([productId])
}

model ProductMatchCandidate {
  id                    String              @id @default(cuid())
  supplierCatalogItemId String
  supplierCatalogItem   SupplierCatalogItem @relation(fields: [supplierCatalogItemId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  score                 Decimal             @db.Decimal(5, 2)
  reasons               Json
  status                CandidateStatus     @default(SUGGESTED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([supplierCatalogItemId, productId])
  @@index([supplierCatalogItemId, status])
  @@index([productId])
}

model ImportReviewIssue {
  id                    String               @id @default(cuid())
  importId              String
  import                PriceImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  supplierCatalogItemId String?
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id], onDelete: SetNull)
  code                  String
  severity              Severity
  message               String
  details               Json?
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())

  @@index([importId])
  @@index([supplierCatalogItemId])
  @@index([code, severity])
}
enum EnrichmentJobStatus {
  NEW
  RESEARCHING
  STOPPED
  COMPLETED
  FAILED
}

enum EnrichmentCandidateStatus {
  NEW
  RESEARCHING
  CONFIRMED
  NEEDS_REVIEW
  REJECTED
  UNRESOLVED
}

enum SourceType {
  MANUFACTURER
  OFFICIAL_DISTRIBUTOR
  PARTS_CATALOG
  LARGE_RETAILER
  MARKETPLACE
  OTHER
}

enum EvidenceType {
  EXACT_ARTICLE
  BRAND_ARTICLE
  PRODUCT_NAME
  OEM_REFERENCE
  GTIN
  CATEGORY
  CROSS_REFERENCE
}

enum EnrichmentDecisionValue {
  ACCEPT
  REVIEW
  REJECT
  UNRESOLVED
}

model EnrichmentJob {
  id              String              @id @default(cuid())
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  name            String
  status          EnrichmentJobStatus @default(NEW)
  totalItems      Int                 @default(0)
  researchedItems Int                 @default(0)
  confirmedItems  Int                 @default(0)
  reviewItems     Int                 @default(0)
  unresolvedItems Int                 @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  candidates      EnrichmentCandidate[]

  @@index([supplierId, status])
}

model EnrichmentCandidate {
  id                    String                    @id @default(cuid())
  jobId                 String
  job                   EnrichmentJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  supplierCatalogItemId String
  supplierCatalogItem   SupplierCatalogItem       @relation(fields: [supplierCatalogItemId], references: [id])
  proposedBrand         String?
  proposedArticle       String?
  proposedName          String?
  proposedCategory      String?
  proposedOemNumbers    Json?
  proposedGtin          String?
  proposedUnit          String?
  confidence            Decimal?                  @db.Decimal(5, 2)
  status                EnrichmentCandidateStatus @default(NEW)
  conflictReason        String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  evidence              EnrichmentEvidence[]
  decisions             EnrichmentDecision[]

  @@unique([jobId, supplierCatalogItemId])
  @@index([jobId, status])
  @@index([supplierCatalogItemId])
}

model EnrichmentEvidence {
  id                  String              @id @default(cuid())
  candidateId         String
  candidate           EnrichmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sourceType          SourceType
  sourceUrl           String
  sourceDomain        String
  sourceTitle         String?
  accessedAt          DateTime
  evidenceType        EvidenceType
  extractedBrand      String?
  extractedArticle    String?
  extractedName       String?
  extractedCategory   String?
  extractedOemNumbers Json?
  extractedGtin       String?
  notes               String?
  reliabilityScore    Int
  createdAt           DateTime            @default(now())

  @@unique([candidateId, sourceUrl, evidenceType])
  @@index([candidateId])
  @@index([sourceDomain])
}

model EnrichmentDecision {
  id          String                  @id @default(cuid())
  candidateId String
  candidate   EnrichmentCandidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  decision    EnrichmentDecisionValue
  decidedBy   String?
  note        String?
  productId   String?
  product     Product?                @relation(fields: [productId], references: [id])
  createdAt   DateTime                @default(now())

  @@index([candidateId])
  @@index([productId])
}