generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  slug           String    @unique
  logoPath       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([isActive, name])
}

model Product {
  id                String           @id @default(cuid())
  sku               String           @unique
  article           String
  normalizedArticle String
  name              String
  slug              String           @unique
  description       String?
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  categoryId        String?
  category          Category?        @relation(fields: [categoryId], references: [id])
  unit              String?
  imagePath         String?
  qualityLevel      String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  offers            SupplierOffer[]
  importRows        PriceImportRow[]
  images            ProductImage[]

  @@unique([brandId, normalizedArticle])
  @@index([normalizedArticle])
  @@index([article])
  @@index([name])
  @@index([categoryId])
  @@index([qualityLevel])
  @@index([isActive, createdAt])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  warehouses Warehouse[]
  offers    SupplierOffer[]
  imports   PriceImport[]
}

model Warehouse {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  name       String
  code       String
  city       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  offers     SupplierOffer[]

  @@unique([supplierId, code])
  @@index([supplierId])
}

model SupplierOffer {
  id                   String           @id @default(cuid())
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  supplierId           String
  supplier             Supplier         @relation(fields: [supplierId], references: [id])
  warehouseId          String?
  warehouse            Warehouse?       @relation(fields: [warehouseId], references: [id])
  supplierArticle      String
  purchasePrice        Decimal          @db.Decimal(14, 2)
  retailPrice          Decimal          @db.Decimal(14, 2)
  currency             String           @default("RUB")
  stockQuantity        Int
  minimumOrderQuantity Int              @default(1)
  deliveryDaysMin      Int?
  deliveryDaysMax      Int?
  availableAt          DateTime?
  sourceUpdatedAt      DateTime?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  importRows           PriceImportRow[]

  @@unique([supplierId, warehouseId, supplierArticle])
  @@index([productId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([retailPrice])
  @@index([stockQuantity])
  @@index([isActive])
}

model PriceImport {
  id              String           @id @default(cuid())
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  sourceFilename  String
  sourceHash      String
  status          String
  totalRows       Int              @default(0)
  validRows       Int              @default(0)
  invalidRows     Int              @default(0)
  createdProducts Int              @default(0)
  updatedProducts Int              @default(0)
  createdOffers   Int              @default(0)
  updatedOffers   Int              @default(0)
  startedAt       DateTime
  finishedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  rows            PriceImportRow[]

  @@index([supplierId])
  @@index([sourceHash, status])
}

model PriceImportRow {
  id             String        @id @default(cuid())
  importId       String
  import         PriceImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  status         String
  errorCode      String?
  errorMessage   String?
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  offerId        String?
  offer          SupplierOffer? @relation(fields: [offerId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([importId, rowNumber])
  @@index([status])
  @@index([productId])
  @@index([offerId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}
