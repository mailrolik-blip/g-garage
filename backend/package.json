{
    "name":  "ggarage-catalog-backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "lint":  "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" \"tests/**/*.ts\"",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:integration":  "vitest run tests/integration tests/import",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev --name init",
                    "db:seed":  "tsx prisma/seed.ts",
                    "db:studio":  "prisma studio",
                    "price:inspect":  "tsx scripts/inspect-orion-price.ts",
                    "import:orion":  "tsx scripts/import-orion-price.ts",
                    "catalog:review":  "tsx scripts/catalog-review.ts",
                    "catalog:import-review":  "tsx scripts/catalog-import-review.ts",
                    "enrich:sample":  "tsx scripts/enrich-sample.ts",
                    "enrich:research":  "tsx scripts/enrich-research.ts"
                },
    "dependencies":  {
                         "@fastify/cors":  "^10.0.1",
                         "@fastify/rate-limit":  "^10.1.1",
                         "@prisma/client":  "^6.1.0",
                         "dotenv":  "^17.4.2",
                         "fastify":  "^5.2.1",
                         "xlsx":  "^0.18.5",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.17.0",
                            "@types/node":  "^22.10.2",
                            "eslint":  "^9.17.0",
                            "prettier":  "^3.4.2",
                            "prisma":  "^6.1.0",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.7.2",
                            "typescript-eslint":  "^8.18.1",
                            "vitest":  "^2.1.8"
                        },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               }
}
